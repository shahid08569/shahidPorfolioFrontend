{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/shahid-portfolio-ui/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://shahid-api.runasp.net/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://shahid-api.runasp.net/uploads/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
